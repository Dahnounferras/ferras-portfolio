---
const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="mono muted row">
    <span>© {year} Ferras</span>
    <span>Set in Instrument Serif &amp; JetBrains Mono</span>
    <span>Shot on silicon &amp; silver</span>
  </div>
</footer>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 40px 0 56px;
    border-top: 1px solid var(--rule);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
</style>
